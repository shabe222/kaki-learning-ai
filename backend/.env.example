# =============================================================================
# 柿子智学 - 教师版配置模板
# =============================================================================
# 
# 首次使用前，请将本文件复制为 .env 并填写以下必需配置：
#
# 1. SECRET_KEY: 生成强随机密钥（至少32位）
#    示例生成命令: python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 2. DEEPSEEK_API_KEY: 到 https://platform.deepseek.com 注册获取
#
# 3. INITIAL_ADMIN_PASSWORD: 设置管理员初始密码（建议8位以上）
#
# 配置完成后运行 start.ps1 即可启动系统
# =============================================================================

MODE=production
DEBUG=false
HOST=127.0.0.1
PORT=8001
DB_ENGINE=sqlite
DATABASE_URL=sqlite+aiosqlite:///./ml_learning.db

# AI 模型配置（必需）
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SEC=90
DEEPSEEK_API_KEY=REPLACE_WITH_YOUR_DEEPSEEK_KEY
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 安全配置（必需）
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

REDIS_ENABLED=false
MILVUS_ENABLED=false
MINIO_ENABLED=false
OPENMAIC_ENABLED=false
SEEDANCE_ENABLED=false

# 管理员账户配置（必需）
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD
INITIAL_ADMIN_DISPLAY_NAME=柿子智学管理员
# Internal teaching-video provider (never expose as a standalone service).
# Rotate any credential previously pasted into chat before setting this true.
CLOUD_VIDEO_KEYS_ROTATED=false
DASHSCOPE_API_KEY=
CLOUD_VIDEO_PROVIDER=s2v
CLOUD_VIDEO_S2V_MODEL=wan2.2-s2v
CLOUD_VIDEO_S2V_DETECT_MODEL=wan2.2-s2v-detect

# Continuous voice conversation ASR (local faster-whisper, no cloud key needed).
# "tiny"/"base" mis-hear code-switched terms such as Python / nonlocal; "small"
# transcribes them correctly at roughly 2.5s per utterance on CPU. The model is
# downloaded from Hugging Face on first use.
WORKSPACE_WHISPER_MODEL=small
WORKSPACE_WHISPER_DEVICE=cpu
WORKSPACE_WHISPER_COMPUTE_TYPE=int8

# 检索出口（与模型分开配置）。DuckDuckGo 直连在需要代理的线路上不通
# （实测 EMPTY / 10s 超时），走代理约 2s 返回；不配则检索走直连。
# http://127.0.0.1:7897 走该代理；direct 强制直连；留空沿用环境变量。
SEARCH_PROXY=
